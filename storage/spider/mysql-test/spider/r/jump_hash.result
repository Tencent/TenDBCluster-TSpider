#
# Test partitioning using JUMP HASH
#
for master_1
for child2
child2_1
child2_2
child2_3
for child3
child3_1
child3_2
child3_3
id varchar(32)

drop and create databases
connection master_1;
DROP DATABASE IF EXISTS auto_test_local;
CREATE DATABASE auto_test_local;
USE auto_test_local;
connection child2_1;
DROP DATABASE IF EXISTS auto_test_remote;
CREATE DATABASE auto_test_remote;
USE auto_test_remote;
connection child2_2;
DROP DATABASE IF EXISTS auto_test_remote_2;
CREATE DATABASE auto_test_remote_2;
USE auto_test_remote_2;

create table for child

create table for master
connection master_1;
DROP TABLE IF EXISTS t1;;
CREATE TABLE t1 (id varchar(32))ENGINE=Spider DEFAULT CHARSET=utf8 PARTITION BY LIST (MURMUR_JUMP_HASH(id, 2))( PARTITION `pt0` VALUES IN (0) COMMENT = 'database "auto_test_remote", table "t1", srv "s_2_1",aim "0"', PARTITION `pt1` VALUES IN (1) COMMENT = 'database "auto_test_remote_2", table "t1", srv "s_2_2",aim "1"');;
SELECT MURMUR_JUMP_HASH("b",1) AS val;
val
0
SELECT MURMUR_JUMP_HASH("b",2) AS val;
val
1
SELECT MURMUR_JUMP_HASH("b",10) AS val;
val
4
SELECT MURMUR_JUMP_HASH("b",100) AS val;
val
4
INSERT INTO t1 VALUES
("a"),("b"),("c"),("d");
SELECT id FROM t1 WHERE id="b";
id
b

# The record should be in the second partition
connection child2_1;
SELECT id FROM auto_test_remote.t1 WHERE id="b";
id
connection child2_2;
SELECT id FROM auto_test_remote_2.t1 WHERE id="b";
id
b
connection master_1;

deinit
connection master_1;
DROP DATABASE IF EXISTS auto_test_local;
connection child2_1;
DROP DATABASE IF EXISTS auto_test_remote;
connection child2_2;
DROP DATABASE IF EXISTS auto_test_remote_2;
for master_1
for child2
child2_1
child2_2
child2_3
for child3
child3_1
child3_2
child3_3

end of test
